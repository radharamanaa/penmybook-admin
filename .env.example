# BookForge Admin control plane — independent-deployment config.
#
# This stack (admin-spa + book_admin + admin-api + its own Mongo) is deployed
# SEPARATELY from BookForge (decision log D1/D2). It reaches DOWN into BookForge's
# internal endpoints; BookForge never reaches up. Point these at the BookForge
# stack's address — in prod the BookForge VM, locally the root compose's host ports.
#
# Copy to admin/.env and adjust. `docker compose -f admin/docker-compose.yml up`.

# ── Secrets (set real values in prod) ─────────────────────────────────────────
# Admin login JWT — DISTINCT from the mesh key; >=32 bytes (Nimbus HS256 minimum).
ADMIN_JWT_SECRET=dev-insecure-admin-secret-change-me-32b!
# Shared mesh key — lets the admin stack mint service tokens to call BookForge.
SERVICE_JWT_SIGNING_KEY=integration-suite-hs256-shared-key-32+bytes
# First admin account (bcrypt hash; never a plaintext password).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# ── Reaching BookForge ────────────────────────────────────────────────────────
# Local (against the root docker-compose.yml on the same host): the BookForge
# services are published on host ports 18101/18102/18103 and 8000, reachable from
# the admin containers via host.docker.internal.
ENTITLEMENTS_URL=http://host.docker.internal:18101
BILLING_URL=http://host.docker.internal:18102
ORG_URL=http://host.docker.internal:18103
CURATOR_INTERNAL_URL=http://host.docker.internal:8000
# Prod: set these to the BookForge VM's internal addresses, e.g.
#   ENTITLEMENTS_URL=http://10.0.1.5:8101  (firewall: admin -> BookForge ALLOW)
